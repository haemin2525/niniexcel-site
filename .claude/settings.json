{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\n### \" + (now | strftime(\"%Y-%m-%d %H:%M\")) + \" — 사용자\\n\\n\" + .prompt + \"\\n\"' >> /Users/hyemin/workspace/niniexcel-site/conversation.md 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
